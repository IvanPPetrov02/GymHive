{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "AuthService": {
    "BaseUrl": "http://localhost:5010"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/Authentication/{**catch-all}"
          }
        ]
      },
      "gym-route": {
        "ClusterId": "gym-cluster",
        "Match": {
          "Path": "/api/gyms/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/Gyms/{**catch-all}"
          }
        ]
      },
      "membership-route": {
        "ClusterId": "gym-cluster",
        "Match": {
          "Path": "/api/memberships/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/Memberships/{**catch-all}"
          }
        ]
      },
      "gymgroup-route": {
        "ClusterId": "gym-cluster",
        "Match": {
          "Path": "/api/gymgroups/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/GymGroups/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5010"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Path": "/health"
          }
        }
      },
      "gym-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Path": "/health"
          }
        }
      }
    }
  }
}
