# Frontend Environment Example for GymHive
# Copy this file to .env.local (ignored by git) and fill in real values.

# Auth0 Configuration
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=YOUR_CLIENT_ID
# Audience (fixed in code to https://api.gymhive.local but you can override if needed)
VITE_AUTH0_AUDIENCE=https://api.gymhive.local
VITE_AUTH0_SCOPE=openid profile email

# API Gateway / Backend Base URL (preferred)
VITE_API_GATEWAY_URL=http://localhost:5000
# Fallback single API origin alias (used if API_GATEWAY_URL absent)
VITE_API_URL=http://localhost:5000

# Optional individual microservice URLs (only needed if bypassing gateway)
VITE_GYMS_SERVICE_URL=
VITE_IDENTITY_SERVICE_URL=
VITE_MEDIA_SERVICE_URL=
VITE_NOTIFICATIONS_SERVICE_URL=
VITE_SOCIAL_FEED_SERVICE_URL=
VITE_WORKOUT_SERVICE_URL=

# Build metadata (optional override)
VITE_APP_VERSION=0.1.0

