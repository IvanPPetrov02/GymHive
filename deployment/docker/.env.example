# Docker Compose Environment Variables
# Copy this file to .env and update with your actual values
# NOTE: .env file is gitignored and should NEVER be committed

# Authentication Service Database
AUTH_DB_ROOT_PASSWORD=YOUR_SECURE_ROOT_PASSWORD_HERE
AUTH_DB_NAME=GymHive
AUTH_DB_USER=gymhive_user
AUTH_DB_PASSWORD=YOUR_SECURE_AUTH_DB_PASSWORD_HERE

# Gym Service Database
GYM_DB_ROOT_PASSWORD=YOUR_SECURE_ROOT_PASSWORD_HERE
GYM_DB_NAME=GymHiveGyms
GYM_DB_USER=gymhive_user
GYM_DB_PASSWORD=YOUR_SECURE_GYM_DB_PASSWORD_HERE

# JWT Configuration (Shared across all services)
# IMPORTANT: Generate a strong random secret for production!
# Use: openssl rand -hex 32
JWT_SECRET=GENERATE_YOUR_OWN_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=GymHive
JWT_AUDIENCE=GymHive
JWT_EXPIRATION_HOURS=24

# Password Pepper (Additional secret for password hashing)
# IMPORTANT: Generate a unique random string for production!
# This adds an extra security layer beyond BCrypt salts
PASSWORD_PEPPER=GENERATE_YOUR_OWN_RANDOM_PEPPER_STRING
