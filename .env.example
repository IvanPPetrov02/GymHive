# =============================================================================
# GymHive Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file with real secrets to version control!
# Generate secure random strings: openssl rand -hex 32
# =============================================================================

# =============================================================================
# JWT TOKEN (Used by AuthenticationService - generates tokens)
# =============================================================================
# This is the secret key used to sign JWT tokens
# Should match the "Token" value in AuthenticationService/appsettings.json
# NOTE: MembershipService has this too but shouldn't need it - authentication 
#       should go through the gateway to AuthenticationService
JWT_SECRET=YOUR_JWT_SECRET_AT_LEAST_32_CHARACTERS_HERE

# =============================================================================
# PASSWORD HASHING (Used by AuthenticationService only)
# =============================================================================
# Additional secret for password hashing (beyond BCrypt salt)
# WARNING: NEVER CHANGE after users exist! You won't be able to validate passwords
PASSWORD_PEPPER=GENERATE_YOUR_OWN_RANDOM_PEPPER_STRING

# =============================================================================
# DATABASE CREDENTIALS (MySQL - Used by multiple services)
# =============================================================================
# AuthenticationService Database
AUTH_DB_SERVER=localhost
AUTH_DB_PORT=3306
AUTH_DB_NAME=GymHive
AUTH_DB_USER=root
AUTH_DB_PASSWORD=YOUR_MYSQL_ROOT_PASSWORD

# GymService Database
GYM_DB_SERVER=localhost
GYM_DB_PORT=3306
GYM_DB_NAME=GymHiveGyms
GYM_DB_USER=root
GYM_DB_PASSWORD=YOUR_MYSQL_ROOT_PASSWORD

# NotificationsService Database
NOTIFICATIONS_DB_SERVER=localhost
NOTIFICATIONS_DB_PORT=3306
NOTIFICATIONS_DB_NAME=GymHiveNotifications
NOTIFICATIONS_DB_USER=root
NOTIFICATIONS_DB_PASSWORD=YOUR_MYSQL_ROOT_PASSWORD

# WorkoutLoggingService Database
WORKOUT_DB_SERVER=localhost
WORKOUT_DB_PORT=3306
WORKOUT_DB_NAME=GymHiveWorkoutLogs
WORKOUT_DB_USER=root
WORKOUT_DB_PASSWORD=YOUR_MYSQL_ROOT_PASSWORD

# =============================================================================
# MONGODB CREDENTIALS (Used by MembershipService)
# =============================================================================
MONGODB_CONNECTION_STRING=mongodb://localhost:27017
MONGODB_DATABASE_NAME=GymHiveMembershipsV2

# =============================================================================
# MESSAGE BROKER (RabbitMQ - Used by all microservices for async events)
# =============================================================================
# All services use RabbitMQ for messaging/events
# Should match the Password in all services' appsettings.json RabbitMQ sections
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=gymhive
RABBITMQ_PASSWORD=YOUR_RABBITMQ_PASSWORD_HERE

# =============================================================================
# SONARQUBE (Code quality analysis - Optional, for developers)
# =============================================================================
SONAR_HOST_URL=http://localhost:9000

# Generate token from SonarQube UI: 
# 1. Start SonarQube: docker-compose -f docker-compose-sonar.yml up -d
# 2. Login to http://localhost:9000 (default: admin/admin)
# 3. Go to: My Account > Security > Generate Tokens
# 4. Copy the token here and also set via: $env:SONAR_TOKEN = "your-token"
SONAR_TOKEN=

# SonarQube's PostgreSQL database credentials
# Used by docker-compose-sonar.yml to configure the database container
# You can keep defaults (sonar/sonar) or set your own for security
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=YOUR_SONAR_DB_PASSWORD_HERE

# =============================================================================
# API GATEWAY
# =============================================================================
GATEWAY_PORT=5000

# =============================================================================
# SERVICE ENDPOINTS
# =============================================================================
AUTH_SERVICE_URL=http://localhost:5010
GYM_SERVICE_URL=http://localhost:5001
MEMBERSHIP_SERVICE_URL=http://localhost:5002
NOTIFICATIONS_SERVICE_URL=http://localhost:5003
WORKOUT_SERVICE_URL=http://localhost:5004

# =============================================================================
# CORS SETTINGS
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*

# =============================================================================
# ENVIRONMENT
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
NODE_ENV=development
